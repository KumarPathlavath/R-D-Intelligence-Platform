# Environment configuration for Signal-to-Opportunity Engine

# LLM Providers (Optional: system provides rich deterministic fallback if not set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding Provider ('local' for sentence-transformers, 'openai' for text-embedding-3-small)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
DATA_DIR=data
VECTOR_DB_DIR=data/vector_store
SQLITE_DB_PATH=data/intelligence_engine.db

# Ingestion settings
ENABLE_LIVE_FEEDS=true
MAX_ITEMS_PER_SOURCE=30
INGESTION_INTERVAL_HOURS=6
SIMILARITY_GAP_THRESHOLD=0.68
NOVELTY_SCORE_THRESHOLD=0.35
